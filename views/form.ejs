<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 text-gray-800 font-sans min-h-screen flex justify-center py-8">
    <div class="w-full max-w-3xl bg-white shadow-sm border border-gray-200 p-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">
            <%= materi ? 'Edit Materi' : 'Tambah Materi Baru' %>
        </h2>
        <form id="materiForm" class="space-y-4">
            <input type="hidden" id="materiId" value="<%= materi ? materi.id : '' %>">
            <div class="flex gap-4">
                <div class="w-1/2">
                    <label class="block text-xs font-bold text-gray-700 mb-1">Mata Kuliah *</label>
                    <input type="text" id="mataKuliah" value="<%= materi ? materi.mata_kuliah : '' %>" required
                        class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
                </div>
                <div class="w-1/2">
                    <label class="block text-xs font-bold text-gray-700 mb-1">Pertemuan *</label>
                    <!-- Tambahkan min="1" di dalam tag input di bawah ini -->
                    <input type="number" id="pertemuan" name="pertemuan" value="<%= materi ? materi.pertemuan : '' %>"
                        required min="1" class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
                </div>
            </div>
            <div>
                <label class="block text-xs font-bold text-gray-700 mb-1">Judul Materi *</label>
                <input type="text" id="judul" value="<%= materi ? materi.judul : '' %>" required
                    class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
            </div>
            <div>
                <label class="block text-xs font-bold text-gray-700 mb-1">Status</label>
                <select id="status" class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
                    <option value="Draf" <%=materi && materi.status==='Draf' ? 'selected' : '' %>>Draf</option>
                    <option value="Terbit" <%=materi && materi.status==='Terbit' ? 'selected' : '' %>>Terbit</option>
                </select>
            </div>
            <div class="flex justify-between items-center pt-6 border-t mt-6">
                <a href="/"
                    class="border border-gray-300 text-gray-700 px-4 py-2 rounded text-sm font-medium hover:bg-gray-100">Batal</a>
                <button type="submit"
                    class="bg-gray-800 text-white px-4 py-2 rounded text-sm font-medium hover:bg-gray-900">Simpan
                    Materi</button>
            </div>
        </form>
    </div>
    <script>
        document.getElementById('materiForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const id = document.getElementById('materiId').value;
            const data = {
                mata_kuliah: document.getElementById('mataKuliah').value,
                pertemuan: document.getElementById('pertemuan').value,
                judul: document.getElementById('judul').value,
                status: document.getElementById('status').value
            };
            const method = id ? 'PUT' : 'POST';
            const url = id ? `/api/materi/${id}` : '/api/materi';

            const response = await fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            if (response.ok) window.location.href = '/';
        });
    </script>
</body>

</html>