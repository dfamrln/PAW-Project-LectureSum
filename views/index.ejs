<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-800 font-sans min-h-screen flex justify-center py-8">
    <div class="w-full max-w-5xl bg-white shadow-sm border border-gray-200">
        <div class="flex justify-between items-center px-8 py-4 border-b border-gray-200">
            <h1 class="text-xl font-bold text-gray-900">Lecture Sum</h1>
            <span class="text-sm text-gray-500">Akun Dosen</span>
        </div>
        <div class="p-8">
            <div class="flex justify-between items-start mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-900 mb-1">Dashboard Materi</h2>
                    <p class="text-gray-500 text-sm">Kelola rekaman, draf, dan ringkasan perkuliahan Anda.</p>
                </div>
                <a href="/form" class="bg-gray-800 text-white px-4 py-2 rounded text-sm font-medium hover:bg-gray-900 transition">+ Tambah Materi</a>
            </div>

            <div class="border border-gray-200 rounded-sm mb-6">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-100 text-xs text-gray-600 uppercase">
                            <th class="px-4 py-3 font-semibold w-2/5">Materi</th>
                            <th class="px-4 py-3 font-semibold text-center w-1/6">Pertemuan</th>
                            <th class="px-4 py-3 font-semibold text-center w-1/6">Status</th>
                            <th class="px-4 py-3 font-semibold text-center w-1/4">Aksi</th>
                        </tr>
                    </thead>
                    <tbody class="text-sm">
                        <% if(materi.length === 0) { %>
                            <tr><td colspan="4" class="text-center py-4 text-gray-500">Belum ada data materi.</td></tr>
                        <% } %>
                        <% materi.forEach(item => { %>
                            <tr class="border-t border-gray-200">
                                <td class="px-4 py-4">
                                    <p class="font-bold text-gray-900"><%= item.judul %></p>
                                    <p class="text-gray-500 text-xs"><%= item.mata_kuliah %></p>
                                </td>
                                <td class="px-4 py-4 text-center"><%= item.pertemuan %></td>
                                <td class="px-4 py-4 text-center">
                                    <span class="<%= item.status === 'Terbit' ? 'text-green-600' : 'text-gray-500' %> font-semibold"><%= item.status %></span>
                                </td>
                                <td class="px-4 py-4 text-center flex justify-center gap-2">
                                    <a href="/form?id=<%= item.id %>" class="border border-blue-400 text-blue-600 px-3 py-1 text-xs hover:bg-blue-50">Edit</a>
                                    <button onclick="hapusMateri(<%= item.id %>)" class="border border-red-400 text-red-600 px-3 py-1 text-xs hover:bg-red-50">Hapus</button>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <script>
        async function hapusMateri(id) {
            if(confirm('Yakin menghapus materi ini?')) {
                const response = await fetch(`/api/materi/${id}`, { method: 'DELETE' });
                if(response.ok) window.location.reload();
            }
        }
    </script>
</body>
</html>